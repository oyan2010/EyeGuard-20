    <!-- Tips Screen -->
    <string name="tips_screen_title">Eye Health &amp; Ergonomics</string>
    <string name="tip_rule_title">The 20-20-20 Rule</string>
    <string name="tip_rule_desc">Every 20 minutes spent looking at a screen, pause and look at something at least 20 feet (6 meters) away for 20 seconds. This relaxes the ciliary muscles inside your eyes.</string>
    <string name="tip_dry_eyes_title">Combat Dry Eyes</string>
    <string name="tip_dry_eyes_desc">When concentrating on screens, our blink rate drops from 15–20 times per minute to only 5–7 times. Remember to blink fully to refresh your tear film.</string>
    <string name="tip_distance_title">Ideal Screen Distance</string>
    <string name="tip_distance_desc">Hold your phone roughly 30 to 40 cm (12 to 16 inches) away from your face. Avoid using devices right before sleep in completely dark rooms.</string>
    <string name="tip_lighting_title">Ambient Lighting</string>
    <string name="tip_lighting_desc">Match your screen brightness to the ambient light in your room. Excessive glare and harsh contrasts accelerate optical fatigue.</string>
    <string name="tips_disclaimer">This application provides ergonomic wellness reminders and is not a substitute for professional medical diagnosis or optometrist care.</string>

